{
  "name": "lifty",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:race": "node scripts/test-race.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e:local": "playwright test -c playwright.local.config.ts",
    "stack:up": "node scripts/local-stack.mjs up",
    "stack:down": "node scripts/local-stack.mjs down",
    "stack:gateway": "node scripts/local-stack.mjs gateway"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@sentry/react": "^11.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "fflate": "0.8.3",
    "mapbox-gl": "^3.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "1.64.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "24.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
